<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
  --green-900:#0d2e15;--green-800:#1a5c2a;--green-700:#2d8c3e;
  --green-600:#2d8c3e;--green-500:#3aad50;--green-400:#5cc96e;
  --orange:#f47820;--orange-light:#f9a45c;--orange-dark:#c45e10;
  --green-100:#e8f8f0;--green-50:#f2fbf6;
  --amber:#f47820;--red:#e74c3c;--blue:#2980b9;
  --gray-900:#1a1a2e;--gray-800:#16213e;
  --white:#ffffff;--gray-50:#f8fafb;--gray-100:#f0f5f1;
  --gray-200:#e2ece7;--gray-300:#c8ddd1;--gray-500:#3d5c48;
  --gray-600:#2a3d32;--text:#0f1f16;
  --shadow:0 2px 12px rgba(20,90,50,.10);
  --shadow-md:0 4px 24px rgba(20,90,50,.14);
  --sidebar-w:220px;
  --topbar-h:96px;
}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0;}
body{font-family:'Inter',sans-serif;background:var(--gray-100);color:var(--text);overscroll-behavior:none;min-height:100vh;}

/* ── INPUTS ── */
input,select,textarea{
  background:var(--white);border:1.5px solid var(--gray-200);color:var(--text);
  border-radius:10px;padding:9px 12px;font-size:13px;width:100%;
  outline:none;font-family:inherit;-webkit-appearance:none;
  box-shadow:0 1px 3px rgba(0,0,0,.04);transition:border .2s;
}
input:focus,select:focus,textarea:focus{border-color:#2d8c3e;box-shadow:0 0 0 3px rgba(45,140,62,.12);}
select option{background:var(--white);color:var(--text);}

/* ── TOPBAR (mobile + desktop) ── */
#topbar{
  background:linear-gradient(135deg,#0d3d1a 0%,#1a4a22 50%,#0d3d1a 100%);
  border-bottom:2px solid rgba(244,120,32,.3);
  position:fixed;top:0;left:0;right:0;z-index:50;
  height:var(--topbar-h);
  display:flex;align-items:center;
  padding:0 16px;
  box-shadow:0 3px 20px rgba(0,0,0,.35);
}
#topbar-inner{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1400px;margin:0 auto;}

/* ── SIDEBAR (desktop only) ── */
#sidebar{
  display:none;
  position:fixed;top:var(--topbar-h);left:0;bottom:0;width:var(--sidebar-w);
  background:linear-gradient(180deg,#0a2e12 0%,#061a0b 100%);
  border-right:1px solid rgba(244,120,32,.15);
  z-index:40;overflow-y:auto;padding:16px 0;
}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:11px 20px;cursor:pointer;
  font-size:13px;font-weight:600;color:rgba(255,255,255,.55);
  transition:all .2s;border-left:3px solid transparent;
  border:none;background:none;width:100%;font-family:inherit;text-align:left;
}
.nav-item:hover{background:rgba(255,255,255,.06);color:rgba(255,255,255,.85);}
.nav-item.active{background:rgba(244,120,32,.15);color:#f4a050;border-left:3px solid #f47820;font-weight:700;}
.nav-icon{font-size:16px;width:20px;text-align:center;flex-shrink:0;}

/* ── BOTTOM NAV (mobile only) ── */
#bottomnav{
  position:fixed;bottom:0;left:0;right:0;z-index:50;
  background:linear-gradient(135deg,#0d2e15,#1a1a2e);
  border-top:1px solid rgba(255,255,255,.08);
  display:flex;height:56px;
  box-shadow:0 -2px 16px rgba(0,0,0,.2);
}
.bnav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:2px;cursor:pointer;border:none;background:none;font-family:inherit;
  color:rgba(255,255,255,.4);font-size:9px;font-weight:600;transition:all .2s;
  padding:4px 0;
}
.bnav-item.active{color:#f47820;}
.bnav-item .bnav-icon{font-size:18px;line-height:1;}

/* ── MAIN CONTENT ── */
#main{
  margin-top:var(--topbar-h);
  padding:20px 16px 72px;
  max-width:700px;margin-left:auto;margin-right:auto;
}

/* ── DESKTOP LAYOUT ── */
@media(min-width:768px){
  #sidebar{display:block;}
  #bottomnav{display:none;}
  #main{
    margin-left:var(--sidebar-w);
    max-width:none;
    padding:28px 32px 40px;
    margin-top:var(--topbar-h);
    margin-right:0;
  }
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
  .grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  .dash-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
  .dash-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px;}
  .form-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  #topbar-inner{padding-left:calc(var(--sidebar-w) + 16px);}
}
@media(max-width:767px){
  .grid-2,.grid-3,.grid-4{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .dash-row,.dash-row-3{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
}

/* ── CARDS ── */
.card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow);}
@media(min-width:768px){.card{padding:20px;border-radius:18px;}}

/* ── KPI CARDS ── */
.kpi-card{border-radius:16px;padding:16px;box-shadow:0 3px 16px rgba(0,0,0,.15);margin-bottom:0;}
@media(min-width:768px){.kpi-card{padding:20px;border-radius:18px;}}

/* ── BADGES ── */
.badge{border-radius:999px;padding:3px 9px;font-size:10px;font-weight:700;white-space:nowrap;}
.b-lime{background:#e8f5ea;color:#1a5c2a;border:1px solid #a8d5b0;}
.b-amber{background:#fef9c3;color:#a16207;border:1px solid #fde68a;}
.b-sky{background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;}
.b-stone{background:var(--gray-100);color:var(--gray-600);border:1px solid var(--gray-200);}
.b-red{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;}
.b-orange{background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;}
.b-purple{background:#f3e8ff;color:#7c3aed;border:1px solid #ddd6fe;}

/* ── LABELS ── */
.label{font-size:10px;font-weight:700;color:#2a3d32;text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:5px;}

/* ── SECTION TITLE ── */
.section-title{font-size:16px;font-weight:800;color:#0d2e15;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
@media(min-width:768px){.section-title{font-size:18px;margin-bottom:18px;}}

/* ── TOAST ── */
.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-weight:700;font-size:13px;text-align:center;display:none;box-shadow:0 8px 32px rgba(0,0,0,.15);white-space:nowrap;}

/* ── SPINNER ── */
.spinner{width:15px;height:15px;border:2px solid rgba(255,255,255,.2);border-top:2px solid #f47820;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;flex-shrink:0;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ── BUTTONS ── */
.btn{padding:11px 16px;border-radius:12px;border:none;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;transition:all .2s;}
.btn-green{background:linear-gradient(135deg,#1a5c2a,#2d8c3e);color:#fff;box-shadow:0 3px 12px rgba(45,140,62,.3);}
.btn-green:hover{box-shadow:0 4px 16px rgba(46,204,113,.4);}
.btn-green:active{transform:translateY(1px);}
.btn-ghost{background:#f0f5f1;color:#0d2e15;border:1.5px solid var(--gray-200);}
.btn-ghost:hover{background:var(--gray-200);}
.btn-red{background:#fef2f2;color:#dc2626;border:1.5px solid #fecaca;}
.btn-red:hover{background:#fee2e2;}
.btn:disabled{opacity:.5;cursor:not-allowed;}

/* ── FILTERS ── */
.filter-btn{padding:6px 14px;border-radius:999px;font-size:11px;font-weight:700;border:none;cursor:pointer;font-family:inherit;transition:all .2s;}
.f-active{background:#f47820;color:#fff;box-shadow:0 2px 8px rgba(244,120,32,.3);}
.f-inactive{background:var(--gray-100);color:#2a3d32;border:1px solid var(--gray-200);}

/* ── ICON BUTTONS ── */
.icon-btn{background:var(--gray-100);border:1.5px solid var(--gray-200);color:#2a3d32;padding:7px 10px;border-radius:8px;cursor:pointer;font-size:13px;line-height:1;transition:all .2s;}
.icon-btn:hover{background:var(--gray-200);}
.icon-btn-green{background:#dcfce7;border:1.5px solid #bbf7d0;color:#15803d;padding:7px 10px;border-radius:8px;cursor:pointer;font-size:13px;line-height:1;}
.icon-btn-orange{background:#fff7ed;border:1.5px solid #fed7aa;color:#c2410c;padding:7px 10px;border-radius:8px;cursor:pointer;font-size:13px;line-height:1;}

/* ── MODAL ── */
.modal-overlay{position:fixed;inset:0;background:rgba(13,51,32,.55);backdrop-filter:blur(4px);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px;}
.modal{background:var(--white);border:1.5px solid var(--gray-200);border-radius:20px;padding:22px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-md);}

/* ── TABLE ── */
.data-table{width:100%;border-collapse:collapse;font-size:13px;}
.data-table th{background:var(--gray-100);color:#1a2e22;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--gray-200);}
.data-table td{padding:10px 12px;border-bottom:1px solid var(--gray-100);vertical-align:middle;}
.data-table tr:last-child td{border-bottom:none;}
.data-table tr:hover td{background:var(--gray-50);}

/* ── NOTIF DOT ── */
.notif-dot{width:7px;height:7px;background:#ef4444;border-radius:50%;display:inline-block;margin-left:3px;vertical-align:middle;}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--gray-300);border-radius:4px;}
</style>
</head>
